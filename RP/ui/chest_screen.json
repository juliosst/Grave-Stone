{
	"namespace": "chest",
	"chest_label": {
		"$new_container_title|default": "$container_title",
		"text": "$new_container_title"
	},
	"small_chest_screen@common.inventory_screen_common": {
		"$close_on_player_hurt|default": true,
		"$use_custom_pocket_toast|default": false,
		"use_custom_pocket_toast": "$use_custom_pocket_toast",
		"close_on_player_hurt": "$close_on_player_hurt",
		"$new_container_title|default": "$container_title",
		"$container_size|default": 27,
		"modifications": [
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": {
					"requires": "(not(($new_container_title - '§6Grave of§r') = $new_container_title))",
					"$screen_content": "chest.grave_stone_panel",
					"$new_container_title": "entity.grave:grave_stone.name"
				}
			}
		]
	},
	"grave_stone_container_grid@common.container_grid": {
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 3,
		"grid_item_template": "@common.container_item",
		"collection_name": "container_items",
		"$item_collection_name": "container_items",
		"maximum_grid_items": "$container_size"
	},
	"grave_stone_scroll_panel@common.scrolling_panel_with_offset": {
		"$scrolling_content": "chest.grave_stone_container_grid",
		"$scrolling_pane_offset": [
			0,
			0
		],
		"$scrolling_pane_size": [
			"100%",
			"100%"
		],
		"$scrolling_pane_size_touch": [
			"100%",
			"100%"
		],
		"$scroll_size_touch": [
			0,
			"100%"
		],
		"$scroll_view_port_size": [
			"100%",
			"100%"
		],
		"$scroll_view_port_size_touch": [
			"100%",
			"100%"
		],
		"$scroll_view_port_offset": [
			0,
			0
		],
		"$scroll_view_port_offset_touch": [
			0,
			0
		],
		"$wider_scroll_area": false,
		"$allow_scrolling_even_when_content_fits": false
	},
	"grave_stone_top_half": {
		"type": "panel",
		"size": [
			"100%",
			120
		],
		"offset": [
			0,
			11
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"controls": [
			{
				"chest_label@chest.chest_label": {}
			},
			{
				"scrolling_panel@chest.grave_stone_scroll_panel": {
					"offset": [
						0,
						-4
					],
					"size": [
						162,
						90
					]
				}
			}
		]
	},
	"grave_stone_root_panel@common.root_panel": {
		"size": [
			178,
			204
		],
		"layer": 1,
		"controls": [
			{
				"common_panel@common.common_panel": {
					"$dialog_background": "common.dialog_background_opaque"
				}
			},
			{
				"chest_panel": {
					"type": "panel",
					"layer": 5,
					"controls": [
						{
							"grave_stone_top_half@chest.grave_stone_top_half": {}
						},
						{
							"inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
						},
						{
							"hotbar_grid@common.hotbar_grid_template": {}
						},
						{
							"inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
						},
						{
							"flying_item_renderer@common.flying_item_renderer": {
								"layer": 15
							}
						}
					]
				}
			},
			{
				"inventory_selected_icon_button@common.inventory_selected_icon_button": {}
			},
			{
				"gamepad_cursor@common.gamepad_cursor_button": {}
			}
		]
	},
	"grave_stone_panel": {
		"type": "panel",
		"controls": [
			{
				"container_gamepad_helpers@common.container_gamepad_helpers": {}
			},
			{
				"selected_item_details_factory@common.selected_item_details_factory": {}
			},
			{
				"item_lock_notification_factory@common.item_lock_notification_factory": {}
			},
			{
				"root_panel@chest.grave_stone_root_panel": {}
			}
		]
	}
}